# secrets — never commit
.env
.env.*
!.env.example

# deps / build
node_modules/
dist/
build/
*.tsbuildinfo
.turbo/

# reference clones (re-clone via docs/PROTOCOL_NOTES.md links)
reference/

# probe artifacts
artifacts/
*.log

# editors / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# embedded Postgres data (DATABASE_URL=pglite://…)
.pglite/

# Per-package env written by setup scripts (partner API keys)
.env.local
**/.env.local

# Build output that does not match the `dist/` pattern, plus the widget bundle the
# mini-app and demo site copy in from packages/embed at build time. Both are produced
# by `pnpm build`; committing them means a stale copy shipping instead of a fresh one.
dist-miniapp/
packages/telegram/miniapp/public/relay.iife.js
apps/demo-site/public/relay.iife.js
