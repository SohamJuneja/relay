# ── Somnia Shannon testnet (chain 50312) ─────────────────────────────────────
# HTTP JSON-RPC. Public alias of the same network as api.infra.testnet.
RPC_URL=https://dream-rpc.somnia.network
# WebSocket RPC. This is the URL the dreamdex-bot-kit pins in
# packages/ec-core/src/config.ts (ENDPOINTS.testnet.ws). The markets-sdk's own
# somniaShannon chain definition lists wss://dream-rpc.somnia.network/ws as a
# secondary alias.
WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
CHAIN_ID=50312
NETWORK=testnet

# DreamDEX indexer (Envio/Hasura GraphQL). Only the markets-sdk path uses it;
# every fact the probe prints is ALSO read raw from chain, so this may be down.
INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# Venue scope. Leave blank: the probe infers it from live MarketCreated logs and
# prints the value to paste here. Venue ids MOVE (they changed three times in
# one week per the kit) — never hard-code one without checking.
VENUE_ID=

# Phase 1+: the key the trade/settle scripts sign with (funded Shannon key:
# STT for gas, tUSDC from the public faucet). Phase 0's probe ignores it.
# Never committed (.gitignore), never printed — scripts print the address only.
PRIVATE_KEY=

# Phase 1 trade script: leave unset for A=UP,B=UP; `hedge` buys UP (A) and DOWN (B)
# so `pnpm settle` is guaranteed a winning side to redeem.
# TRADE_MODE=hedge

# Probe tuning (optional)
# How many hours of chain history to scan for MarketCreated / OrderFilled.
PROBE_WINDOW_HOURS=6
# Parallel eth_getLogs requests. The RPC caps each call at 1000 blocks.
PROBE_LOG_CONCURRENCY=8

# ── Phase 2: indexer + API ───────────────────────────────────────────────────
# Postgres 16 from docker-compose.yml (port 5433 to avoid clashing with a local PG).
# Alternative without Docker: an embedded Postgres (PGlite) at a directory:
#   DATABASE_URL=pglite://./.pglite
DATABASE_URL=postgres://relay:relay@localhost:5433/relay
# Backfill window (hours) when START_BLOCK is unset; ~36 000 blocks/hour at 100 ms blocks.
BACKFILL_HOURS=24
# START_BLOCK=
INDEXER_CHUNK=1000
INDEXER_CONCURRENCY=8
INDEXER_CONFIRMATIONS=5
INDEXER_REORG_DEPTH=50
INDEXER_TAIL_POLL_MS=1500
# Builder fee used for the PROJECTED partner revenue (bps; mainnet cap is 100 = 1 %).
BUILDER_FEE_BPS=100
PRICE_ASSETS=BTC,ETH
# API
API_PORT=8787
API_HOST=0.0.0.0

# Testnet gas drip (POST /v1/gas-drip): the stand-in for a mainnet paymaster.
# Defaults are the production values; raise them only for an automated test run.
# GAS_DRIP_PER_HOUR=3
# GAS_DRIP_PER_ADDRESS_HOURS=24
# API_RATE_LIMIT_PER_MIN=60
