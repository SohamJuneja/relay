{
  "name": "@relay/telegram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Relay on Telegram \u00e2\u20ac\u201d a mini-app that mounts the widget with surface=telegram, and a bot that posts live window cards.",
  "scripts": {
    "setup:partner": "tsx scripts/setup-partner.ts",
    "miniapp:dev": "vite --config vite.config.ts",
    "miniapp:build": "node scripts/sync-widget.mjs && vite build --config vite.config.ts",
    "bot": "tsx src/bot.ts",
    "tunnel": "node scripts/tunnel.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@relay/core": "workspace:*",
    "grammy": "^1.30.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@relay/embed": "workspace:*",
    "@types/node": "^20.14.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.3.5",
    "vitest": "^2.1.0"
  },
  "exports": {
    "./copy": {
      "types": "./src/copy.ts",
      "default": "./src/copy.ts"
    },
    "./relay": {
      "types": "./src/relay.ts",
      "default": "./src/relay.ts"
    },
    "./polling": {
      "types": "./src/polling.ts",
      "default": "./src/polling.ts"
    },
    "./ipv4-first": {
      "types": "./src/ipv4-first.ts",
      "default": "./src/ipv4-first.ts"
    }
  }
}
