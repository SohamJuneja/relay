{
  "name": "@relay/ui-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Relay design tokens — one palette, spacing scale and typeface pairing, shared by the embed widget and the partner console.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build:css": "tsx scripts/emit-css.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
