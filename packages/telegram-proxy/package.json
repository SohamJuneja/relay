{
  "name": "@relay/telegram-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker forwarding the Telegram Bot API, because Render's egress to api.telegram.org times out.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "wrangler deploy",
    "secret": "wrangler secret put BOT_TOKEN",
    "tail": "wrangler tail --format pretty"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.130.0"
  }
}
