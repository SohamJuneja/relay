{
  "name": "@relay/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Relay core — chain config, DreamDEX Event Contract ABIs, market discovery from chain logs, book/pool reads, encoding helpers. Browser-safe (no Node built-ins).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "default": "./src/browser.ts"
    },
    "./order": {
      "types": "./src/order.ts",
      "default": "./src/order.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "viem": "^2.21.0",
    "vitest": "^2.1.0",
    "esbuild": "^0.28.2"
  }
}
